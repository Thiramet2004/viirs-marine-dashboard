<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<StyledLayerDescriptor version="1.0.0" xsi:schemaLocation="http://www.opengis.net/sld StyledLayerDescriptor.xsd" xmlns="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NamedLayer>
    <Name>SST_anomalies</Name>
    <UserStyle>
      <Name>SST_anomalies</Name>
      <Title>SST_anomalies</Title>
      <FeatureTypeStyle>
        <Rule>
          <Name/>
          <RasterSymbolizer>
            <ColorMap type="ramp">
              <ColorMapEntry color="#000064" quantity="-5" label="-5 °C" opacity="1"/>
              <ColorMapEntry color="#050582" quantity="-4.5" label="-4.5 °C" opacity="1"/>
              <ColorMapEntry color="#1414A5" quantity="-4" label="-4 °C" opacity="1"/>
              <ColorMapEntry color="#1E2AC3" quantity="-3.5" label="-3.5 °C" opacity="1"/>
              <ColorMapEntry color="#2146E1" quantity="-3" label="-3 °C" opacity="1"/>
              <ColorMapEntry color="#256EF9" quantity="-2.5" label="-2.5 °C" opacity="1"/>
              <ColorMapEntry color="#3099FF" quantity="-2" label="-2 °C" opacity="1"/>
              <ColorMapEntry color="#4BC8FF" quantity="-1.5" label="-1.5 °C" opacity="1"/>
              <ColorMapEntry color="#8CEBFF" quantity="-1" label="-1 °C" opacity="1"/>
              <ColorMapEntry color="#C8FAFF" quantity="-0.5" label="-0.5 °C" opacity="1"/>
              <ColorMapEntry color="#FFFFFF" quantity="0" label="0 °C" opacity="1"/>
              <ColorMapEntry color="#FFFAAA" quantity="0.5" label="0.5 °C" opacity="1"/>
              <ColorMapEntry color="#FFED50" quantity="1" label="1 °C" opacity="1"/>
              <ColorMapEntry color="#FFD21E" quantity="1.5" label="1.5 °C" opacity="1"/>
              <ColorMapEntry color="#FFA00A" quantity="2" label="2 °C" opacity="1"/>
              <ColorMapEntry color="#FA6904" quantity="2.5" label="2.5 °C" opacity="1"/>
              <ColorMapEntry color="#F03501" quantity="3" label="3 °C" opacity="1"/>
              <ColorMapEntry color="#D21000" quantity="3.5" label="3.5 °C" opacity="1"/>
              <ColorMapEntry color="#A50300" quantity="4" label="4 °C" opacity="1"/>
              <ColorMapEntry color="#870000" quantity="4.5" label="4.5 °C" opacity="1"/>
              <ColorMapEntry color="#6E0000" quantity="5" label="5 °C" opacity="1"/>
            </ColorMap>
          </RasterSymbolizer>
        </Rule>
      </FeatureTypeStyle>
    </UserStyle>
  </NamedLayer>
</StyledLayerDescriptor>